# URLs on which the HTTP server listens.
ASPNETCORE_URLS=http://127.0.0.1:8080
# Root directory searched for journal files.
Zitat__JournalDirectory=/var/log/journal

# To serve HTTPS, enable the LoadCredential= lines in zitat.service and
# these settings. Separate multiple URLs with semicolons. Kestrel reads
# the certificate only at startup; restart the service after renewal.
#ASPNETCORE_URLS=https://0.0.0.0:8443
#Kestrel__Certificates__Default__Path=/run/credentials/zitat.service/tls.crt
#Kestrel__Certificates__Default__KeyPath=/run/credentials/zitat.service/tls.key
