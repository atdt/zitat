# Bind to the host's Tailscale address to serve other tailnet hosts.
ASPNETCORE_URLS=http://127.0.0.1:8080
# The journal tree to read. /var/log/journal covers both the local journal and
# the remote/ subdirectory systemd-journal-remote writes into.
Zitat__JournalDirectory=/var/log/journal
Zitat__TailIntervalMilliseconds=1000
