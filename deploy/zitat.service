[Unit]
Description=Zitat journal search
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
DynamicUser=yes
# systemd-journal grants read access to local journal files.
# systemd-journal-remote grants read access to journals received from
# other hosts over the network (present only on log-aggregator hosts).
SupplementaryGroups=systemd-journal systemd-journal-remote
WorkingDirectory=/opt/zitat
ExecStart=/opt/zitat/zitat
Environment=ASPNETCORE_URLS=http://127.0.0.1:8080
Environment=Zitat__JournalDirectory=/var/log/journal
EnvironmentFile=-/etc/zitat.env
# For HTTPS, copy the certificate and key into the service's credentials
# directory, which the dynamic user can read. See zitat.env.example.
#LoadCredential=tls.crt:/etc/letsencrypt/live/zitat.example.com/fullchain.pem
#LoadCredential=tls.key:/etc/letsencrypt/live/zitat.example.com/privkey.pem
# .NET opens its per-user X.509 stores under HOME when it builds the
# certificate chain. The dynamic user has no home directory.
#RuntimeDirectory=zitat
#Environment=HOME=%t/zitat
# A failed hosted service can stop the host with a clean exit. Restart it
# even when systemd does not classify the exit as a failure.
Restart=always
RestartSec=5s

# Resource limits target a host with 2 GB of memory and four CPU cores.
MemoryHigh=192M
MemoryMax=256M
CPUQuota=150%
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/var/log/journal

[Install]
WantedBy=multi-user.target
