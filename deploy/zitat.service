[Unit]
Description=Zitat journal search
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
DynamicUser=yes
# The systemd-journal group grants read access to local journal files.
# To read journals collected by systemd-journal-remote, add the
# systemd-journal-remote group to SupplementaryGroups in a drop-in.
SupplementaryGroups=systemd-journal
WorkingDirectory=/usr/lib/zitat
ExecStart=/usr/lib/zitat/zitat
Environment=ASPNETCORE_URLS=http://127.0.0.1:8080
Environment=Zitat__JournalDirectory=/var/log/journal
EnvironmentFile=-/etc/default/zitat
# A failed hosted service can stop the host with a clean exit. Restart it
# even when systemd does not classify the exit as a failure.
Restart=always
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/var/log/journal
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
