{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Zitat": {
    "DatabasePath": "zitat.db",
    "UdpPort": 5514,
    "TcpPort": 5514,
    "RetentionDays": 14,
    "MaxStorageBytes": 1073741824,
    "MaxMessageBytes": 65536,
    "FloodMessagesPerSecond": 500,
    "FloodBurst": 1000
  }
}
