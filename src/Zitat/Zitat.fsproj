<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>zitat</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!-- Trimming requires a self-contained publish; leave a framework-dependent
       `dotnet publish` working. `full` overrides the web SDK's default of
       `partial`: nothing here serializes or binds by reflection, and
       TreatWarningsAsErrors turns any future trim warning into a build
       failure. -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Journal/Format.fs" />
    <Compile Include="Journal/SipHash.fs" />
    <Compile Include="Journal/Zstd.fs" />
    <Compile Include="Journal/Mapping.fs" />
    <Compile Include="Journal/JournalFile.fs" />
    <Compile Include="Journal/Scan.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="Journal/Reader.fs" />
    <Compile Include="Configuration.fs" />
    <Compile Include="Query.fs" />
    <Compile Include="Live.fs" />
    <Compile Include="Follower.fs" />
    <Compile Include="WebJson.fs" />
    <Compile Include="Web.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Falco" Version="5.2.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.12" />
  </ItemGroup>
</Project>
